{
  "port": 18704,
  "idleMs": 150000,
  "selector": "account",
  "upstreams": [
    {
      "preset": "google-workspace",
      "policy": {
        "*": {
          "deny": [
            "delete_item",
            "batch_delete",
            "empty_trash",
            "delete_event",
            "delete_email",
            "delete_draft",
            "delete_label",
            "delete_filter",
            "create_filter",
            "remove_permission",
            "share_file",
            "batch_share"
          ]
        },
        "work": {
          "deny": [
            "send_email",
            "delete_email"
          ]
        }
      }
    }
  ]
}
